{
  "name": "stagesync",
  "version": "5.4.3",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "migrate:legacy": "pnpm --filter @stagesync/server migrate:legacy",
    "sync-version": "node launch/scripts/sync-version.mjs",
    "sync:launcher-ui": "node launch/scripts/sync-launcher-ui.mjs",
    "lint:ss-css": "node launch/scripts/lint-ss-css.mjs",
    "lint:knip": "knip --no-exit-code",
    "benchmark:record": "npx tsx launch/scripts/record-benchmark.ts",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch{}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23"
  }
}
