{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StageSync",
        "theme": "Dark",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html",
        "dragDropEnabled": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 520,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true
      }
    ]
  }
}
