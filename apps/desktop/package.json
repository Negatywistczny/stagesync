{
  "name": "@stagesync/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "StageSync Tauri thin shell — WebView to local server (ADR 0010)",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/sync-launcher-ui.mjs && node ./scripts/sync-sidecar-server.mjs && tauri dev",
    "build": "node -e \"console.log('@stagesync/desktop: skip turbo build — use pnpm tauri build')\"",
    "sync-ui": "node ./scripts/sync-launcher-ui.mjs",
    "tauri": "tauri",
    "tauri:build": "node ./scripts/sync-launcher-ui.mjs && tauri build",
    "check-types": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node --test launcher/*.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}