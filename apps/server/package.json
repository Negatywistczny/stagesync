  "devDependencies": {
    "@stagesync/eslint-config": "workspace:*",
    "@stagesync/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
