{
  "name": "@stagesync/web",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build && vite build --mode performer && vite build --mode console && node scripts/aggregate-role-ui.mjs",
    "build:full": "tsc --noEmit && vite build",
    "build:performer": "vite build --mode performer",
    "build:console": "vite build --mode console",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "@stagesync/shared": "workspace:*",
    "@stagesync/ui": "workspace:*",
    "lucide-react": "^1.28.0",
    "opensheetmusicdisplay": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stagesync/eslint-config": "workspace:*",
    "@stagesync/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "modern-screenshot": "^4.7.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
