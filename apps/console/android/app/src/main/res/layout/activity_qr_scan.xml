<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_scan_qr"
        android:textColor="@color/ss_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/qr_hint"
        android:textColor="@color/ss_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/qr_paste_hint"
        android:textColor="@color/ss_muted" />

    <EditText
        android:id="@+id/qrUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/ss_elevated"
        android:hint="@string/hint_url"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="@color/ss_text"
        android:textColorHint="@color/ss_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUseQrUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_use_url" />
</LinearLayout>
