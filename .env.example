# apps/server — HTTP listen (default 4000)
PORT=4000

# Absolute or relative path to data root (library + projects).
# Default (desktop / user host): ~/Documents/StageSync
# Default (Docker / Compose):    /app/data  (set explicitly in compose files)
# STAGESYNC_DATA_DIR=

# Set to 1 during local development to keep data under <repo>/data
# instead of ~/Documents/StageSync.
STAGESYNC_REPO_DEV=1

# Prod / Docker: Vite build directory served by the Node server.
# STAGESYNC_STATIC_DIR=/app/web

# Tauri thin shell (apps/desktop) — URL of local StageSync host.
# STAGESYNC_URL=http://127.0.0.1:4000/admin

# Optional Host MIDI ports (apps/server only — never Tauri). IDs like
# "input:Port Name" / "output:Port Name" from GET /api/midi.
# STAGESYNC_MIDI_INPUT=
# STAGESYNC_MIDI_OUTPUT=

# LAN Host restart/shutdown (POST /api/system/restart|shutdown).
# Loopback is always allowed. From LAN: Bearer token OR allow-flag (trusted nets only).
# See docs/INSTALL.md § Host restart / shutdown (LAN). Admin may store token in
# localStorage key stagesync.hostToken.
# STAGESYNC_HOST_TOKEN=
# STAGESYNC_ALLOW_REMOTE_LIFECYCLE=1

# Optional Operator PIN — gates destructive Admin REST (project/setlist/settings…).
# Transport Play/Pause/Stop/Seek/Loop and MIDI Panic stay ungated. Empty = off.
# Clients unlock via Admin/Timeline gate or Client settings (sessionStorage).
# Header: X-Stagesync-Operator-Pin (alias X-StageSync-PIN).
# STAGESYNC_OPERATOR_PIN=

# Safety Net Master/Spare — Spare disables MIDI OUT (manual promote only).
# STAGESYNC_SAFETY_ROLE=master
# STAGESYNC_SAFETY_ROLE=spare

# Default theme for clients without a saved local preference (FOUT / first join).
# booth | daylight | midnight | matrix | neon (legacy: dark/light/*-high)
# STAGESYNC_THEME_DEFAULT=booth

# Optional Sentry crash reporting (omit in local/dev — no DSN = no reporting).
# Never commit real DSN values. Server reads SENTRY_DSN; web build reads VITE_SENTRY_DSN.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# ── Production only (compose.prod.yml) ──────────────────────────────────────

# Image version to pull from GHCR (compose.prod.yml).
# STAGESYNC_VERSION=5.2.0

# GHCR credentials for Watchtower image pull.
# Generate a GitHub PAT with read:packages scope.
# GHCR_USER=your-github-username
# GHCR_TOKEN=ghp_...

# Watchtower HTTP API token (shared between compose.prod.yml and apps/server).
# Generate a random secret: openssl rand -hex 32
# WATCHTOWER_TOKEN=

# GitHub API token for update-status (Docker/host). Private repo needs Contents read;
# public repos work without a token. Desktop sidecar skips this check (Tauri updater).
# Fine-grained PAT: Contents read-only on this repo.
# STAGESYNC_GITHUB_TOKEN=ghp_...

# Optional: protect Admin restart/shutdown when called off-loopback (LAN phone, etc.).
# Desktop / localhost always allowed. Set one of:
# STAGESYNC_HOST_TOKEN=  (Bearer or X-Stagesync-Host-Token; also localStorage stagesync.hostToken)
# STAGESYNC_ALLOW_REMOTE_LIFECYCLE=1

# Optional backups directory (Admin path + restore mapping). Empty = {dataDir}/backups.
# STAGESYNC_BACKUPS_DIR=
