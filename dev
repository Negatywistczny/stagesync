#!/usr/bin/env bash
set -e

# StageSync — Unix DX Launcher (macOS / Linux)

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# Node.js
if ! command -v node &> /dev/null; then
    echo "[!] Nie znaleziono Node.js. Wymagany Node.js 22+."
    echo "    Wskazówka: bash scripts/setup/setup.sh"
    exit 1
fi

# pnpm
if ! command -v pnpm &> /dev/null; then
    echo "[STEP] Włączanie pnpm przez corepack..."
    corepack enable pnpm || true
    corepack install || true
    if ! command -v pnpm &> /dev/null; then
        echo "[STEP] Instalacja pnpm globalnie przez npm..."
        npm install -g pnpm || true
    fi
fi

if ! command -v pnpm &> /dev/null; then
    PNPM_CMD="npx pnpm"
else
    PNPM_CMD="pnpm"
fi

# Zależności
if [ ! -d "node_modules" ] || [ ! -f "node_modules/.modules.yaml" ]; then
    echo "[STEP] Instalacja zależności Node (pnpm install)..."
    $PNPM_CMD install
fi

export NODE_NO_WARNINGS=1

# Dev Hub
if [ $# -gt 0 ]; then
    $PNPM_CMD dev:hub "$@"
else
    $PNPM_CMD dev:hub
fi
