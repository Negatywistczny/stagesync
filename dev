#!/usr/bin/env bash
set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
AUTO_CONFIRM=false

if [[ "$1" == "-y" || "$1" == "--yes" ]]; then
    AUTO_CONFIRM=true
fi

ask_confirm() {
    local message="$1"
    if [ "$AUTO_CONFIRM" = true ]; then
        return 0
    fi
    read -p "$(echo -e "${YELLOW}${message} [T/n]: ${NC}")" response
    response=${response,,}
    if [[ -z "$response" || "$response" == "t" || "$response" == "y" ]]; then
        return 0
    else
        return 1
    fi
}

# 1. Check Node.js
if ! command -v node &> /dev/null; then
    echo -e "${YELLOW}⚠️ Nie znaleziono Node.js w systemie.${NC}"
    if ask_confirm "Czy chcesz zainstalować Node.js (wersja >=22) automatycznie przy użyciu fnm?"; then
        echo "Pobieranie i instalacja fnm..."
        if curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell; then
            export PATH="$HOME/.local/share/fnm:$PATH"
            eval "`fnm env`"
            fnm install 22 && fnm use 22
        else
            echo -e "${RED}Błąd podczas pobierania fnm.${NC}"
            exit 1
        fi
    else
        echo -e "${RED}Przerwano. Skrypt wymaga Node.js.${NC}"
        exit 1
    fi
fi

# 2. Check pnpm & corepack
if ! command -v pnpm &> /dev/null; then
    echo -e "${CYAN}Włączanie pnpm przez corepack...${NC}"
    corepack enable pnpm 2>/dev/null || true
    corepack install 2>/dev/null || true
fi

# 3. Check node_modules
if [ ! -d "$SCRIPT_DIR/node_modules" ] || [ ! -d "$SCRIPT_DIR/node_modules/@clack/prompts" ]; then
    echo -e "${CYAN}Instalacja zależności Node (pnpm install)...${NC}"
    pnpm install
fi

export NODE_NO_WARNINGS=1

# 4. Dev Hub Handoff
if [ -n "$1" ]; then
    pnpm dev:hub "$1"
else
    pnpm dev:hub
fi
