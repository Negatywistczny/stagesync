{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["launch/scripts/*.{js,mjs}"],
      "project": ["launch/scripts/**/*.{js,mjs}"]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/main-client.tsx",
        "src/main-console.tsx",
        "src/**/*.{test,spec}.{ts,tsx}",
        "scripts/*.{js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,mjs}"]
    },
    "apps/desktop": {
      "entry": ["src-tauri/src/main.rs", "src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/www": {
      "entry": ["src/main.ts", "vite.config.ts"],
      "project": ["src/**/*.ts", "vite.config.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "apps/performer/**",
    "apps/console/**",
    "apps/www/dist/**",
    "**/dist/**",
    "**/.turbo/**"
  ],
  "ignoreDependencies": ["@stagesync/eslint-config", "@stagesync/typescript-config"]
}
