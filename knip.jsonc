{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{js,mjs,ts}"
      ],
      "project": [
        "scripts/**/*.{js,mjs,ts}"
      ]
    },
    "apps/server": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main-client.tsx",
        "src/main-console.tsx",
        "src/**/*.{test,spec}.{ts,tsx}",
        "scripts/*.{js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{js,mjs}"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignore": [
    "apps/performer/**",
    "apps/console/**",
    "apps/www/dist/**",
    "**/dist/**",
    "**/.turbo/**"
  ]
}