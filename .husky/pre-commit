# StageSync pre-commit sanity gate
# - Fast: no tests (run in CI / manually via pnpm test)
# - Guards: type errors + lint warnings + dead code / broken imports (knip)

set -e
pnpm --filter @stagesync/shared --filter @stagesync/server --filter @stagesync/web run check-types
pnpm --filter @stagesync/shared --filter @stagesync/server --filter @stagesync/web run lint
pnpm lint:knip
pnpm generate:map && git add docs/REPO_MAP.md